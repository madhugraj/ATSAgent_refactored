{
  "extends": "../../tools/tsconfig.base.json",
  "compilerOptions": {
    // Interim (while app-side shims stand, removed in Phase 8): this package's
    // typecheck program reaches the app (publish.server → app work-mode,
    // guards; ingest.server → app intake.server; partner.ts/registry.ts →
    // app integrations.server until those move). Same aliases as
    // apps/web/tsconfig.json and packages/integrations tsconfig.json, so
    // every package resolves them to the same files.
    "paths": {
      "@/*": ["../../apps/web/src/*"],
      "@db/*": ["../../apps/web/drizzle/*"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
