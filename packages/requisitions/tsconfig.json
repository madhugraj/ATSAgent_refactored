{
  "extends": "../../tools/tsconfig.base.json",
  "compilerOptions": {
    // Interim (while app-side shims stand, removed in Phase 8): this package's
    // typecheck program reaches the app (requisitions.server → org-profile
    // cores; role-profile → the AI gateway shim). Same aliases as
    // apps/web/tsconfig.json and packages/distribution tsconfig.json, so
    // every package resolves them to the same files.
    "paths": {
      "@/*": ["../../apps/web/src/*"],
      "@db/*": ["../../apps/web/drizzle/*"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
