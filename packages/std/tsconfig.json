{
  "extends": "../../tools/tsconfig.base.json",
  "compilerOptions": {
    // Interim (while app-side shims stand, removed in Phase 8): this package's
    // typecheck program reaches the observability package (parser client →
    // @ats/observability/server, whose alerts.server still consumes app-side
    // modules like `@/lib/agents.catalog`). Same aliases as
    // apps/web/tsconfig.json and packages/security/tsconfig.json, so every
    // package resolves them to the same files.
    "paths": {
      "@/*": ["../../apps/web/src/*"],
      "@db/*": ["../../apps/web/drizzle/*"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
